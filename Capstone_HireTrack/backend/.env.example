# Copy this file to .env and fill in real values. Never push .env to GitHub.
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/interview_tracker"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=8080
APP_URL="http://localhost:8080"

# Sign in with Google (optional). Create an OAuth Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add http://localhost:8080 to
# "Authorized JavaScript origins". Leave as-is to hide the Google button.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Email (SMTP). Check it with:  npm run email:test -- you@example.com
# Option A - Gmail (real emails): SMTP_HOST="smtp.gmail.com", SMTP_PORT=465,
#   SMTP_USER = your Gmail address, SMTP_PASS = a 16-letter Gmail APP PASSWORD (not your
#   normal password), MAIL_FROM = "HireTrack <your Gmail address>"
# Option B - Mailtrap (safe test inbox): values from Mailtrap > Email Testing > Inboxes > SMTP
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
MAIL_FROM="HireTrack <no-reply@example.com>"

# First HR account, created by: npm run db:seed (run it again after changing these)
SEED_HR_NAME="Your Name"
SEED_HR_EMAIL="hr@example.com"
SEED_HR_PASSWORD="ChangeMe@123"
