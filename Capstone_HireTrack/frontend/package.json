{
  "name": "hiretrack-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Builds css/output.css from css/input.css with Tailwind CSS",
  "scripts": {
    "build:css": "tailwindcss -i ./css/input.css -o ./css/output.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/output.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
